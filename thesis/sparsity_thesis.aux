\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Mechanistic comparison of SHAP and LIME. SHAP (left) decomposes the model output $f(x)$ as the sum of the expected output $E[f(x)]$ and the per-feature Shapley contributions $\phi _i$; LIME (right) fits a locally weighted linear surrogate $g$ to perturbed samples drawn around the instance $x$ within the locality kernel $\pi _x$.}}{11}{figure.caption.4}\protected@file@percent }
\newlabel{fig:shap_vs_lime}{{2.1}{11}{Mechanistic comparison of SHAP and LIME. SHAP (left) decomposes the model output $f(x)$ as the sum of the expected output $E[f(x)]$ and the per-feature Shapley contributions $\phi _i$; LIME (right) fits a locally weighted linear surrogate $g$ to perturbed samples drawn around the instance $x$ within the locality kernel $\pi _x$}{figure.caption.4}{}}
