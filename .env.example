# Django Settings
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Main Database (for tenant management)
DB_NAME=erp_main
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis password (leave empty for local dev; required in production)
REDIS_PASSWORD=

# Docker Settings
DOCKER_ENABLED=True
DOCKER_POSTGRES_IMAGE=postgres:15-alpine
DOCKER_NETWORK=erp_network

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000

# Email Settings (for notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@erp.local

# New Relic APM (leave empty to disable)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=ERP Django


FIELD_ENCRYPTION_KEY=CHANGE-ME-generate-a-32-byte-key-for-field-encryption

# Sentry error tracking (leave empty to disable)
SENTRY_DSN=

# Content Security Policy (requires: pip install django-csp)
# Set CSP_ENABLED=true to activate. Start with CSP_REPORT_ONLY=true first.
CSP_ENABLED=false
CSP_REPORT_ONLY=true
CSP_REPORT_URI=
