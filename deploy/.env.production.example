###############################################################################
# ERP Django — Production Environment Variables
#
# Copy this file to deploy/.env.production and fill in real values before
# running deploy.sh.
###############################################################################

# ─── REQUIRED ───────────────────────────────────────────────────────────────

# Your domain name (without www)
DOMAIN=139-144-57-205.ip.linodeusercontent.com

# Django secret key — generate one:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE-ME-generate-a-real-secret-key

# PostgreSQL credentials for the main (tenant management) database
DB_NAME=erp_main
DB_USER=erp_user
DB_PASSWORD=CHANGE-ME-use-a-strong-password

# ─── SSL ────────────────────────────────────────────────────────────────────

# Set to 'true' to obtain a free Let's Encrypt certificate
ENABLE_SSL=true
# Email for Let's Encrypt notices (required if ENABLE_SSL=true)
SSL_EMAIL=ahmedkuraimi@gmail.com

# ─── SUPERUSER (created on first deploy) ────────────────────────────────────

SUPERUSER_EMAIL=ahmedkuraimi@gmail.com
SUPERUSER_PASSWORD=CHANGE-ME-strong-admin-password
SUPERUSER_FIRST=Admin
SUPERUSER_LAST=User

# ─── APPLICATION ────────────────────────────────────────────────────────────

# System user that runs the app (created automatically)
APP_USER=erp
# Installation directory
APP_DIR=/opt/erpdjango
# Number of Gunicorn worker processes (2 * CPU cores + 1 is recommended)
GUNICORN_WORKERS=3
# Server timezone
TIMEZONE=Asia/Riyadh

# ─── VERSIONS ───────────────────────────────────────────────────────────────

PYTHON_VERSION=3.12
PG_VERSION=15

# ─── EMAIL ──────────────────────────────────────────────────────────────────

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@erp.example.com

# ─── NEW RELIC APM ──────────────────────────────────────────────────────────

NEW_RELIC_LICENSE_KEY=9305EB9BC6E51DE5B9A84DA523F647236671E25A535BD78F6B26C068740CFCCF
NEW_RELIC_APP_NAME=ERP Django



FIELD_ENCRYPTION_KEY=CHANGE-ME-generate-a-32-byte-key-for-field-encryption

